# Backend-only overrides, for running uvicorn outside Docker.
# The root .env.example is the full reference; the backend reads either file.
DATABASE_URL=postgresql+psycopg://ridedemand:ridedemand@localhost:5432/ridedemand

# Test database. Defaults to DATABASE_URL with "_test" appended to the database
# name, so it follows whichever server you are pointed at. Uncomment to override.
# TEST_DATABASE_URL=postgresql+psycopg://ridedemand:ridedemand@localhost:5432/ridedemand_test

GRID_SIZE=0.01
MIN_CELL_PICKUPS=500

CITY_NAME=New York City
BBOX_MIN_LAT=40.55
BBOX_MAX_LAT=40.92
BBOX_MIN_LNG=-74.10
BBOX_MAX_LNG=-73.70
MAP_CENTER_LAT=40.7420
MAP_CENTER_LNG=-73.9800
MAP_DEFAULT_ZOOM=12

TEST_FRACTION=0.2
RANDOM_STATE=42

CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:4173,http://127.0.0.1:3000

# Optional — leave blank and the Driver Copilot uses its deterministic fallback.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
COPILOT_TIMEOUT_SECONDS=20
