# Copy to .env and adjust:  cp .env.example .env
# Never commit a filled-in .env — it is excluded by .gitignore.
# Every value below has a working default in backend/app/config.py, so the
# defaults shipped here run the project as-is.

# =============================================================================
# PostgreSQL
# =============================================================================
POSTGRES_USER=ridedemand
POSTGRES_PASSWORD=ridedemand
POSTGRES_DB=ridedemand
# Host port the database is published on. If you already run PostgreSQL on
# 5432, change this (e.g. 5433) — only the published port moves; inside Docker
# the backend still reaches it on 5432.
POSTGRES_PORT=5432

# Read directly by the backend and the pipeline scripts.
# Running on your machine the host is `localhost`; Docker Compose overrides this
# to `postgres` automatically, so you do not need to edit it for Docker.
DATABASE_URL=postgresql+psycopg://ridedemand:ridedemand@localhost:5432/ridedemand

# Database the test suite creates and uses, kept separate so tests never touch
# development data. Defaults to DATABASE_URL with "_test" appended to the
# database name, so it follows whichever server you are pointed at. Uncomment
# only to send tests somewhere else.
# TEST_DATABASE_URL=postgresql+psycopg://ridedemand:ridedemand@localhost:5432/ridedemand_test

# =============================================================================
# Geographic grid
# =============================================================================
# Cell edge length in decimal degrees. Change it, then re-run the full pipeline
# (prepare_data -> load_db -> train_model) so every stage agrees.
GRID_SIZE=0.01
# Grid cells with fewer total pickups than this are dropped as too sparse.
MIN_CELL_PICKUPS=500

# =============================================================================
# Study area — the bounding box pickups are clipped to, and the initial map view
# =============================================================================
CITY_NAME=New York City
BBOX_MIN_LAT=40.55
BBOX_MAX_LAT=40.92
BBOX_MIN_LNG=-74.10
BBOX_MAX_LNG=-73.70
MAP_CENTER_LAT=40.7420
MAP_CENTER_LNG=-73.9800
MAP_DEFAULT_ZOOM=12

# =============================================================================
# Data preparation and training
# =============================================================================
# Monthly files from the Uber TLC FOIL dataset:
# apr14 may14 jun14 jul14 aug14 sep14
DATA_MONTHS=apr14 may14 jun14
# Share of the most recent dates held out for testing.
TEST_FRACTION=0.2
# Fixed so training runs are reproducible.
RANDOM_STATE=42

# =============================================================================
# API
# =============================================================================
BACKEND_PORT=8000
FRONTEND_PORT=3000
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:4173,http://127.0.0.1:3000

# =============================================================================
# Frontend
# =============================================================================
# Vite inlines this at build time, so changing it requires a rebuild.
VITE_API_BASE_URL=http://localhost:8000

# =============================================================================
# Driver Copilot (optional)
# =============================================================================
# Leave BLANK to use the deterministic fallback. The application is fully
# functional either way, and /api/copilot reports which path produced the text.
# Never commit a real key.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
COPILOT_TIMEOUT_SECONDS=20
