# Vite inlines this at build time, so a change requires a rebuild.
#
# 127.0.0.1 rather than "localhost": a local uvicorn binds IPv4 only, and a
# browser that resolves "localhost" to ::1 would fail to reach it. Under Docker
# Compose the published port serves both stacks and Compose passes its own
# value, so http://localhost:8000 is correct there.
VITE_API_BASE_URL=http://127.0.0.1:8000
